<?xml version="1.0" encoding="utf-8"?>
<!-- Only the folders BookFlow actually shares from: library PDF copies, exports, and camera captures for notes. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="user_docs" path="books/" />
    <cache-path name="shared_docs" path="exports/" />
    <cache-path name="camera" path="camera/" />
</paths>
